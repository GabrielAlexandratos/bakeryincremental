-main ApplicationMain 
-cp /usr/local/lib/haxe/lib/flixel/6,2,0
-D flixel=6.2.0
--macro openfl.utils._internal.ExtraParamsMacro.include()
-cp /usr/local/lib/haxe/lib/openfl/9,5,2/src
-D openfl=9.5.2
--macro lime._internal.macros.DefineMacro.run()
--macro haxe.macro.Compiler.addMetadata("@:autoBuild(lime._internal.macros.AssetsMacro.embedBytes())", "haxe.io.Bytes")
-cp /usr/local/lib/haxe/lib/lime/8,3,2/src
-D lime=8.3.2
--macro keep('IntIterator')
-cp /usr/local/lib/haxe/lib/hscript/2,6,0
-D hscript=2.6.0
-cp source
-D message.reporting=pretty
-D howlerjs
-D lime-webgl
-D lime-dom
-D lime-howlerjs
-D lime-html5
-D FLX_NO_HEALTH
-D MAC_USE_CURRENT_SDK=1
-D lime-threads
-D tools=8.3.2
-D lime-canvas
-D FLX_NO_DEBUG
-D no-compilation
-D openfl-html5
-D NAPE_RELEASE_BUILD
-D html5
-D web
--remap flash:openfl
--macro flixel.system.macros.FlxDefines.run()
-js export/html5/bin/factory.js
-cp export/html5/haxe
-D html5
-debug