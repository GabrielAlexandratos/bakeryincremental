out/

# Locally-installed haxelibs
.haxelib/

# Loose compiled artefacts
*.n
*.swf

# --- Editors ----------------------------------------------------------------
# .vscode/ is tracked on purpose - launch.json and tasks.json are worth sharing.
.idea/workspace.xml
.idea/tasks.xml
.idea/usage.statistics.xml
.idea/shelf/

# --- macOS ------------------------------------------------------------------
.DS_Store
._*
.Spotlight-V100
.Trashes

